{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantara.local/schemas/source-registry.v1.json",
  "title": "Quantara provenance-first source registry",
  "type": "object",
  "required": [
    "schema_version",
    "registry_version",
    "reviewed_at",
    "review_due_at",
    "execution_authority",
    "sources"
  ],
  "properties": {
    "schema_version": { "const": "source-registry-v1" },
    "registry_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "reviewed_at": { "type": "string", "format": "date" },
    "review_due_at": { "type": "string", "format": "date" },
    "execution_authority": { "const": "none" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "publisher",
          "canonical_url",
          "terms_urls",
          "source_class",
          "authority_tier",
          "access_class",
          "ingestion_mode",
          "decision_role",
          "commercial_use_status",
          "update_cadence",
          "domains",
          "permitted_uses",
          "prohibited_uses",
          "validation_requirements",
          "attribution_required",
          "automated_scraping_allowed",
          "retention_policy",
          "revision_policy",
          "enabled"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "publisher": { "type": "string", "minLength": 1, "maxLength": 160 },
          "canonical_url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "terms_urls": {
            "type": "array",
            "items": { "type": "string", "format": "uri", "pattern": "^https://" },
            "uniqueItems": true
          },
          "source_class": {
            "enum": [
              "official_event_data",
              "live_market_data",
              "research_evidence",
              "educational_hypothesis",
              "compliance_policy"
            ]
          },
          "authority_tier": {
            "enum": [
              "official_primary",
              "professional_standard",
              "peer_reviewed_or_scholarly",
              "publisher_reference",
              "vendor_primary",
              "creator_hypothesis",
              "compliance_authority"
            ]
          },
          "access_class": {
            "enum": [
              "public_api_with_terms",
              "public_web_reference",
              "community_noncommercial",
              "copyrighted_reference",
              "restricted_paid",
              "user_supplied_licensed"
            ]
          },
          "ingestion_mode": {
            "enum": [
              "api",
              "youtube_api_metadata",
              "manual_metadata",
              "citation_only",
              "no_ingestion"
            ]
          },
          "decision_role": {
            "enum": [
              "direct_fact",
              "feature_input",
              "validation_method",
              "hypothesis_only",
              "compliance_only"
            ]
          },
          "commercial_use_status": {
            "enum": [
              "approved_subject_to_terms",
              "blocked_pending_license",
              "citation_only",
              "not_applicable"
            ]
          },
          "update_cadence": { "type": "string", "minLength": 1, "maxLength": 100 },
          "domains": { "$ref": "#/$defs/nonEmptyStringArray" },
          "permitted_uses": { "$ref": "#/$defs/nonEmptyStringArray" },
          "prohibited_uses": { "$ref": "#/$defs/nonEmptyStringArray" },
          "validation_requirements": { "$ref": "#/$defs/nonEmptyStringArray" },
          "attribution_required": { "type": "boolean" },
          "automated_scraping_allowed": { "type": "boolean" },
          "retention_policy": { "type": "string", "minLength": 1, "maxLength": 300 },
          "revision_policy": { "type": "string", "minLength": 1, "maxLength": 300 },
          "enabled": { "type": "boolean" },
          "notes": { "type": "string", "maxLength": 500 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    }
  }
}
